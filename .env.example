# RoadSense AI Backend Configuration
# ------------------------------------
# Port and Host (default: 8000 and 127.0.0.1)
PORT=8000
HOST=127.0.0.1

# SQLite Database URL or PostgreSQL URL
# Default: sqlite:///roadsense.db
DATABASE_URL=sqlite:///roadsense.db

# Path to YOLOv8 PyTorch model (.pt)
# Default: backend/models/best.pt
YOLO_MODEL_PATH=models/best.pt

# YOLO detection confidence threshold (float between 0.0 and 1.0)
YOLO_CONFIDENCE_THRESHOLD=0.25

# Allowed CORS origins (comma-separated, default: *)
CORS_ORIGINS=*

# Frontend Configuration (Vite)
# -----------------------------
# Production API Base URL (empty for local dev proxy)
VITE_API_URL=
